{
    "name": "communalists",
    "version": "4.0.0",
    "private": true,
    "description": "Tools and resources for communities to build and sustain mutual aid networks.",
    "engines": {
        "node": ">=24.15 <25"
    },
    "packageManager": "pnpm@12.21.0",
    "scripts": {
        "dev": "node scripts/dev.mjs",
        "dev:next": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint",
        "typecheck": "next typegen && tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "emulators": "node scripts/dev.mjs --emulators-only",
        "seed": "node scripts/seed.mjs",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{ts,tsx,mts,mjs,js}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,mdx,css,yml,yaml}": "prettier --write"
    },
    "dependencies": {
        "class-variance-authority": "^0.7.1",
        "cmdk": "^1.1.1",
        "cn": "^0.5.2",
        "firebase": "^13.4.0",
        "firebase-admin": "^14.5.1",
        "geofire-common": "6.0.0",
        "libphonenumber-js": "^1.13.17",
        "lucide-react": "^1.76.0",
        "next": "16.4.6",
        "next-intl": "^4.15.3",
        "next-themes": "^0.4.6",
        "radix-ui": "^1.8.1",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "server-only": "^0.0.1",
        "shadcn": "^4.23.0",
        "sharp": "0.35.5",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@storybook/addon-a11y": "10.6.7",
        "@storybook/addon-docs": "10.6.7",
        "@storybook/nextjs-vite": "10.6.7",
        "@tailwindcss/turbopack": "4.3.3",
        "@tailwindcss/vite": "4.3.3",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^8.0.0",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.13",
        "@types/node": "^24.19.2",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@vitejs/plugin-react": "^6.3.0",
        "eslint": "^9",
        "eslint-config-next": "16.4.6",
        "eslint-config-prettier": "^10.1.8",
        "firebase-tools": "^15.37.0",
        "husky": "^9.1.7",
        "jsdom": "^31.0.1",
        "lint-staged": "^17.6.1",
        "prettier": "^3.10.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "storybook": "10.6.7",
        "tailwindcss": "4.3.3",
        "typescript": "^5",
        "vite": "^8.3.8",
        "vitest": "^5.1.1"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/techletariats/communalists.git"
    },
    "license": "ISC"
}
