# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# firebase
.firebase/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*
database-debug.log*

# storybook
storybook-static/

*storybook.log

# storybook docs pages generated from documentation/
.storybook/docs/generated/

# Firebase emulator data (pnpm emulators saves it on exit; local test accounts only)
.emulator-data/

# Editor swap files
*.swp
*.swo

# Unfinished emulator saves (pnpm dev removes them on start)
firebase-export-*/

# find-organizations research: the super-user export includes unlisted
# organizations, and research is unverified. Never commit it.
/research/
