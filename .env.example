# Copy to .env.local and fill in. Never commit .env.local.
#
# Local development against the emulators (no real project needed):
#   pnpm emulators   (in one terminal)
#   pnpm dev         (in another)
# with NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-communalists and the emulator
# variables below uncommented.

# Firebase web app config (public by design; security comes from rules and
# server-side checks). Firebase console → Project settings → Your apps.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-communalists
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Admin SDK service account, as one-line JSON. SECRET: set it in Vercel's
# environment variables, never in the repo.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Emulators
# NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
