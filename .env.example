# Copy to .env.local (ready as-is for the emulators). Never commit .env.local.
#
# Local development runs against the Firebase emulators, never real data.
# `pnpm dev` copies this to .env.local if it's missing, starts the emulators
# and Next. The values below are ready for that. Production values live on
# Vercel.

# Firebase web app config (public by design; security comes from rules and
# server-side checks). Firebase console → Project settings → Your apps.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-communalists.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-communalists
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Admin SDK service account JSON. SECRET, production only: it lives in
# Vercel's environment variables. Leave it unset locally (emulators need none).
# FIREBASE_SERVICE_ACCOUNT_KEY=

# Emulators
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
